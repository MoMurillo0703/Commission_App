# Postgres connection string from Supabase: Project Settings → Database.
# For Vercel, use the transaction pooler URI and keep prepare disabled (already set in code).
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Set to disable only for a local Postgres that does not use SSL.
# DATABASE_SSL=disable

# Supabase Auth and Storage. Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Project Settings → API → service_role. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private Storage bucket for original uploaded statement files.
SUPABASE_STORAGE_BUCKET=commission-statements

# Required for the private Vercel demo. Comma-separated allow list of permitted Auth users.
# If omitted locally, any existing Auth user in this Supabase project can sign in.
DEMO_ALLOWED_EMAILS=owner@example.com

# Local-only fallbacks when Supabase Storage is not configured.
# STORAGE_DRIVER=local
# IMPORT_STORAGE_PATH=./data/imports
